+argo_energy() { # "<hours> <drain %/h> <manual|predicted|none>" from Argo; empty when this Argo predates `argo energy`
+  [ "${CLAUDE_HEAVY_ARGO:-on}" != off ] && [ -x "$ARGO" ] || return 0
+  perl -e 'alarm 5; exec @ARGV' "$ARGO" energy plan 2>/dev/null | awk 'NF == 3 && $1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ { print; exit }'
+}
 queued_gates() { find "$GATES_QUEUE" -name '*.req' 2>/dev/null | wc -l | tr -d ' '; }
 budget() { # sets need (battery % this job needs to start on battery) and need_why (how it adds up)
   if [ -n "${HEAVY_BATTERY_MIN:-}" ]; then need=$HEAVY_BATTERY_MIN need_why="flat line HEAVY_BATTERY_MIN"; return; fi
-  local c n h q g
+  local c n h q g eh ed es drain=$BASE_DRAIN src=unplugged
   read -r c n <<<"$(job_cost "$name")"; h=$(unplugged_h)
-  need=$(( RESERVE_PCT + c + h * BASE_DRAIN ))
+  # Energy autopilot (Argo, 24 Nov): Argo answers with the manual plan when there is one, else its outlet
+  # forecast on battery, and the base drain it measured (6 until 3 h of evidence). HEAVY_BASE_DRAIN pins the drain.
+  if [ -z "${HEAVY_BASE_DRAIN:-}" ] && read -r eh ed es <<<"$(argo_energy)" && [ -n "${es:-}" ]; then
+    h=$eh drain=$ed; [ "$es" = predicted ] && src="to an outlet (Argo forecast)"
+  fi
+  need=$(( RESERVE_PCT + c + h * drain ))
   need_why="${RESERVE_PCT}% reserve + ${name:-job} ~${c}%/run ($([ "$n" -gt 0 ] && echo "median of $n measured" || echo "default until 3 runs"))"
-  [ "$h" -gt 0 ] && need_why="$need_why + ${h} h unplugged x ${BASE_DRAIN}%/h"
+  [ "$h" -gt 0 ] && need_why="$need_why + ${h} h ${src} x ${drain}%/h"
   if [ "$name" != gates ] && q=$(queued_gates) && [ "${q:-0}" -gt 0 ]; then
     read -r g _ <<<"$(job_cost gates)"; need=$(( need + q * g )); need_why="$need_why + $q queued gate(s) x ${g}% first"
   fi
