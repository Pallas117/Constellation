   echo "eclipse budget: a gate starts on battery at ${need}%+ (${need_why}); $(queued_gates) gate(s) queued$([ "$h" -gt 0 ] && echo "; unplugged plan: $h h left" || echo "; no unplugged plan (--unplugged <hours>)")"
   name=""
