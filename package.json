{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "dev:proxy": "node --env-file-if-exists=.env --import tsx backend/server.ts",
    "backend:log": "bash scripts/start-backend-logging.sh",
    "parse:logs": "node scripts/log-parser.js",
    "alerts:watch": "node scripts/log-alerts.js",
    "dev:infer": "python3 ml/infer/infer_server.py",
    "dev:all": "concurrently -k \"npm run dev\" \"npm run dev:proxy\"",
    "dev:tailscale": "bash scripts/tailscale/dev-mobile.sh",
    "dev:tailscale:dry": "bash scripts/tailscale/dev-mobile.sh --dry-run",
    "dev:tailscale:doctor": "bash scripts/tailscale/doctor.sh",
    "dev:tailscale:doctor:fix": "bash scripts/tailscale/doctor.sh --kill-ports",
    "wt:create": "bash scripts/worktree/manage.sh create",
    "wt:list": "bash scripts/worktree/manage.sh list",
    "wt:status": "bash scripts/worktree/manage.sh status",
    "wt:sync": "bash scripts/worktree/manage.sh sync",
    "wt:remove": "bash scripts/worktree/manage.sh remove",
    "wt:prune": "bash scripts/worktree/manage.sh prune",
    "wt:doctor": "bash scripts/worktree/manage.sh doctor",
    "release:check": "bash scripts/release/release-check.sh",
    "release:tag": "bash scripts/release/create-tag.sh",
    "release:sbom": "node --import tsx scripts/release/sbom.ts",
    "train:nowcast": "python3 ml/train/train_kp.py",
    "check:backend-env": "node --env-file-if-exists=.env --import tsx backend/scripts/check-env.ts",
    "env:check": "node --import tsx backend/scripts/env-check.ts",
    "check:security-compliance": "node --env-file-if-exists=.env --import tsx backend/scripts/security-compliance-check.ts",
    "audit:adherence": "node --env-file-if-exists=.env --import tsx backend/scripts/full-adherence-audit.ts",
    "setup:rbac": "node --env-file-if-exists=.env --import tsx backend/scripts/rbac-bootstrap.ts",
    "auth:migrate": "node --env-file-if-exists=.env --import tsx backend/scripts/auth-migrate.ts",
    "auth:set-role": "node --env-file-if-exists=.env --import tsx backend/scripts/set-role.ts",
    "mesh:enroll": "node --import tsx backend/scripts/mesh-enroll.ts",
    "org": "node --env-file-if-exists=.env --import tsx backend/scripts/org.ts",
    "test:physics": "node --import tsx --test \"frontend/src/lib/physics/**/*.test.ts\"",
    "test:rbac": "node --env-file-if-exists=.env --import tsx backend/scripts/rbac-smoke.ts",
    "test:backend:harness": "node --import tsx --test backend/server.harness.test.ts",
    "test:ops": "bash scripts/ops/gauss-services.test.sh && cd tools/argo && go test ./...",
    "test:ui": "playwright test",
    "test:ui:mobile": "playwright test tests/e2e/ui-mobile-layout.spec.ts",
    "test:ui:headed": "playwright test --headed",
    "test:ui:debug": "playwright test --debug",
    "test": "TSX_TSCONFIG_PATH=frontend/tsconfig.app.json node --import tsx --import ./backend/test-setup.ts --test \"backend/**/*.test.ts\" \"frontend/src/lib/**/*.test.ts\"",
    "build": "vite build --config frontend/vite.config.ts",
    "build:dev": "vite build --mode development --config frontend/vite.config.ts",
    "lint": "npm run quality:types",
    "preview": "vite preview --config frontend/vite.config.ts",
    "security:audit": "npm audit --audit-level=moderate",
    "security:secrets": "bash scripts/check-secrets-local.sh",
    "security:setup-hooks": "bash scripts/setup-pre-commit.sh",
    "security:full": "npm run security:audit && npm run security:secrets && npm run check:security-compliance",
    "quality:types": "node --import tsx scripts/quality-types.ts frontend/tsconfig.app.json frontend/tsconfig.node.json backend/tsconfig.json tsconfig.tooling.json",
    "quality:lint": "eslint .",
    "quality:full": "npm run quality:types && npm run quality:lint",
    "test:all": "npm test && npm run test:ui",
    "verify": "node --import tsx scripts/verify/verify.ts",
    "replay": "node --import tsx scripts/replay/run.ts",
    "replay:fetch": "node --import tsx scripts/replay/fetch-event.ts",
    "replay:holdout": "node --import tsx scripts/replay/score-holdout.ts",
    "trust:ingest": "node --import tsx scripts/trust/ingest-log.ts",
    "trust:replay": "node --import tsx scripts/trust/replay-records.ts",
    "tpm": "node --import tsx scripts/ops/tpm-check.ts",
    "deploy": "node --import tsx scripts/release/deploy.ts",
    "rollback": "node --import tsx scripts/release/deploy.ts --rollback",
    "perf:check": "npm run build && du -sh frontend/dist",
    "release:prepare": "npm run quality:full && npm run security:full && npm test && npm run release:sbom",
    "test:website": "node --test website/test/site.test.mjs website/test/worker.test.mjs",
    "site:dev": "node website/dev.mjs",
    "site:dev:offline": "node website/dev.mjs --offline",
    "site:forms": "node website/tools/sync_forms.mjs",
    "audit:website": "node website/tools/audit.mjs",
    "smoke:website": "node website/tools/smoke.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@supabase/supabase-js": "^2.86.2",
    "@tanstack/react-query": "^5.83.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/three": "^0.169.0",
    "better-auth": "^1.5.5",
    "better-sqlite3": "^12.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.462.0",
    "neo4j-driver": "^6.0.1",
    "next-themes": "^0.3.0",
    "node-addon-api": "^8.6.0",
    "protobufjs": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.15.4",
    "satellite.js": "7.1.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.169.0",
    "ws": "^8.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react-swc": "latest",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^15.15.0",
    "lovable-tagger": "^1.1.11",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.1"
  },
  "workspaces": [
    "frontend",
    "backend",
    "ml"
  ],
  "overrides": {
    "three-mesh-bvh": "^0.8.0",
    "express": {
      "qs": "^6.16.1"
    }
  }
}
