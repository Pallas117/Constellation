// lightbound.uk: one Cloudflare Worker with static assets. Deploy: see website/README.md.
// This is the public release (GAU-178): only what the public pages need. Opening accounts, forms and payments later
// (RELEASE "full") adds the DATA namespace, Access, secrets and vars listed in the README, "Opening accounts".
{
  "name": "lightbound-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Everything else is a static file: free, and never runs the Worker. /app/* and /argo/ stay listed in a public
    // release, so the Worker can answer 404 for them instead of the static files being served.
    "run_worker_first": ["/", "/gauss/", "/constellation/", "/gauss/apply/", "/constellation/apply/", "/constellation/workshops/", "/education/", "/education/apply/", "/constellation/time/", "/argo/", "/app", "/app/*", "/api/*"]
  },
  // Refresh launches, space weather and events into KV. Free plan: 5 cron triggers per account.
  "triggers": { "crons": ["*/15 * * * *"] },
  // The feed cache, created 23 Oct 2026 with `npx wrangler@4 kv namespace create LIVE` (ids are not secrets).
  "kv_namespaces": [
    { "binding": "LIVE", "id": "1322d2fae0a345c18f94862eebbd1572" }
  ],
  "vars": {
    // "public": pages, feeds and an email route; sign-in, forms, payments and members' pages answer 404 (worker/release.js).
    "RELEASE": "public",
    // Gauss for Education: "off" (opening soon) or "open" (needs RELEASE "full"). Staff price in US cents; empty = "Price TBC".
    "EDU_SALES": "off",
    "EDU_STAFF_PRICE": ""
  },
  // One optional secret in a public release: LL2_API_KEY (`npx wrangler@4 secret put LL2_API_KEY`; README, "Launch").
  // SOURCE_SHA is set at deploy time (README, "Launch"), so /api/health names the commit.
  "observability": { "enabled": true }
  // When the workers.dev preview passes the smoke check, uncomment to serve lightbound.uk (adds proxied A/AAAA
  // records only; the Google Workspace MX records are not touched). Needs Josh's go-ahead: it's the DNS change.
  // ,"routes": [{ "pattern": "lightbound.uk", "custom_domain": true }]
}
