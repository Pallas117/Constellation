# Security headers for static assets (Cloudflare static-assets format).
# Responses the Worker builds itself (/, /constellation/, /api/*) carry the same headers from
# worker/headers.js; website/test/site.test.mjs fails if the two drift apart.
/*
  Content-Security-Policy: default-src 'none'; style-src 'self'; img-src 'self'; media-src 'self'; font-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-site

# Fonts, film and marks rarely change: cache for a week (rename the file if one does change).
# site.css and the pages keep Cloudflare's default (revalidate every time), so edits show at once.
/assets/fonts/*
  Cache-Control: public, max-age=604800
/assets/media/*
  Cache-Control: public, max-age=604800
/assets/marks/*
  Cache-Control: public, max-age=604800
