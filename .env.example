# Frontend
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_GAUSS_RAG_URL=http://127.0.0.1:3002
# IF OFFLOADING: Set this to the Kali Linux IP (e.g., http://10.0.0.x:3001)
VITE_HELIO_PROXY_URL=http://127.0.0.1:3001
VITE_HELIO_WS_ENABLED=false
# When true, only official data adapters (NOAA, MMS, GOES/OMNI) are used by the ingestion pipeline.
# Useful for compliance/testing where only authoritative sources should be trusted.
OFFICIAL_SOURCES_ONLY=false

# Backend proxy
PROXY_PORT=3001
# IF OFFLOADING: Set PROXY_HOST to 0.0.0.0 to listen on all interfaces
PROXY_HOST=127.0.0.1
# IF OFFLOADING: Add your client IP or '*' to ALLOWED_ORIGINS
ALLOWED_ORIGINS=http://localhost:8080
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_ANON_KEY=your-anon-key
AUTH_REQUIRED=true
CYBERTIGER_ENABLED=true
CYBERTIGER_RATE_LIMIT_WINDOW_MS=60000
CYBERTIGER_RATE_LIMIT_MAX=120
CYBERTIGER_AUTH_FAILURE_WINDOW_MS=300000
CYBERTIGER_AUTH_FAILURE_THRESHOLD=8
CYBERTIGER_AUTO_BLOCK_SECONDS=900
CYBERTIGER_MAX_EVENTS=5000
# IF OFFLOADING: If running Deepseek/ML on the same Kali node, localhost:8000 is fine
LOCAL_INFER_URL=http://localhost:8000
TRAINING_SCRIPT_PATH=ml/train/train_unet.py
DEVICE_AUTH_SECRET=replace-with-your-secret-or-leave-empty-for-dev
DEVICE_PROOF_TTL_MS=60000

# Optional RBAC smoke test settings
BACKEND_BASE_URL=http://127.0.0.1:3001
RBAC_VIEWER_EMAIL=
RBAC_VIEWER_PASSWORD=
RBAC_OPERATOR_EMAIL=
RBAC_OPERATOR_PASSWORD=
RBAC_ADMIN_EMAIL=
RBAC_ADMIN_PASSWORD=
RBAC_TEST_TRAIN=false
RBAC_FORCE_PASSWORD_UPDATE=true
RBAC_EMAIL_CONFIRMED=true

# Tailscale/mobile dev notes:
# 1) Use `npm run dev:tailscale` to bind frontend/backend to your Tailscale IP.
# 2) Keep PROXY_HOST off 0.0.0.0. Use 127.0.0.1 or your Tailscale IPv4.
# 3) Run `npm run dev:tailscale:doctor` before launch; use `:doctor:fix` to clear stale ports.
# 4) If CLI is unhealthy, pass TS_IP manually: `TS_IP=100.x.y.z npm run dev:tailscale`.

# Alerts watcher (local)
# Slack incoming webhook URL (use your app's webhook)
SLACK_WEBHOOK_URL=

# Linear API key and team id (for creating issues)
LINEAR_API_KEY=
LINEAR_TEAM_ID=

# Dedup window (seconds) to suppress repeating alerts (default 300)
ALERT_DEDUP_SECONDS=300

# --- Sign-in (better-auth) ---
# Public URL of this backend; Google redirects to <BETTER_AUTH_URL>/api/auth/callback/google
BETTER_AUTH_URL=http://127.0.0.1:3001
# Google Workspace SSO: create an OAuth client (Web application) in Google Cloud.
# Leave empty to hide the "Sign in with Google Workspace" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only this domain may create accounts through SSO (enforced server-side).
SSO_ALLOWED_DOMAIN=lightbound.uk

# --- Mesh & Network (Argo device reports) ---
# Where hashed device tokens and last reports are stored (0600, gitignored).
MESH_STORE_PATH=data/mesh/devices.json
# Approved Tailscale exit nodes shown in onboarding, as name:CC pairs. Only MY/SG are accepted.
MESH_EXIT_NODES=

# --- Device SWAP manager ---
SWAP_BALANCE_INTERVAL_MS=
DEVICE_SWAP_THERMAL_THRESHOLD_C=
DEVICE_SWAP_DEFAULT_POWER_W=
DEVICE_SWAP_DEFAULT_COMPUTE_PERCENT=
CLOSED_LOOP_SCRIPT=

# --- Local data ---
# Override the bedrock telemetry directory (tests point this at a temp dir).
GAUSS_BEDROCK_DIR=

# --- Knowledge integrations (optional; leave empty to disable) ---
NEO4J_URI=
NEO4J_USER=
NEO4J_PASS=
NOTEBOOK_LM_ID=
NOTEBOOK_LM_API_KEY=

# --- Legacy Supabase (pre better-auth; only used by older scripts and data paths) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Frontend ---
VITE_GAUSS_RAG_INDEX_DIR=

# --- Paid data API (organisations, API keys, usage metering) ---
# SQLite file for organisations, plans, hashed API keys and usage (gitignored).
COMMERCE_DB_PATH=data/commerce/commerce.db
