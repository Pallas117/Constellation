{
  // Type-check only: the backend runs under tsx (`node --import tsx`), which
  // transpiles each file on its own with esbuild and never reads these types.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "skipLibCheck": true,

    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,

    "strict": true
  },
  "include": ["**/*.ts"]
}
